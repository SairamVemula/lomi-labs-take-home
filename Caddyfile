# Site block for the VPS's shared Caddy (the one already serving 80/443 for every project).
# It lives in that proxy's Caddyfile, not in a Caddy of our own; compose.prod.yml puts `web` on the
# proxy's network as `lomi-web`. TLS is automatic once the A record for lomi.sairam.cc points at the host.
lomi.sairam.cc {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy lomi-web:3000
}
