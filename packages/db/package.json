{
  "name": "@lomi/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@lomi/shared": "workspace:*",
    "@lomi/storage": "workspace:*",
    "bullmq": "^6.7.10",
    "drizzle-orm": "^0.44.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@lomi/config": "workspace:*",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "testcontainers": "^11.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
